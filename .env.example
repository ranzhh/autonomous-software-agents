# Copy to .env (gitignored) and fill in. NEVER commit real tokens/keys.
#
# What runs WHERE (see docs/decisions/0003-deployment-topology.md):
#   LOCAL  : your agents, your tools, the PDDL solver (pyperplan)
#   REMOTE : game server (unitn or Azure), the LLM (unitn only), the mission-agent
# With unitn VPN, prefer unitn for both game server and LLM (faster). Azure = no-VPN fallback.

# ── Game server (pick ONE) ────────────────────────────────────────────────────
HOST=https://deliveroojs.azurewebsites.net/          # public, no VPN, free tier (slower)
# HOST=https://deliveroojs.bears.disi.unitn.it/      # unitn, needs VPN, faster (preferred)

# Game tokens — one player each. For Part 2 mint BOTH on the SAME team.
# Mint via: npm run token -- <name> [team]   (prints the token; paste it here)
# Example:  npm run token -- ASAP_BDI ASAP   →  TOKEN_BDI=<paste>
#           npm run token -- ASAP_LLM ASAP   →  TOKEN_LLM=<paste>
# If the server requires a password set GAME_PASSWORD in the env before running.
TOKEN_BDI=
TOKEN_LLM=
# GAME_PASSWORD=   # server password forwarded as the 'password' header when minting
# Optional teammate fallback (teammates are matched by teamName; teamId is randomized per mint):
# FRIENDLY_NAMES=
# FRIENDLY_IDS=

# ── LLM (course LiteLLM proxy, OpenAI-compatible — unitn only, needs VPN) ──────
LITELLM_BASE_URL=https://llm.bears.disi.unitn.it/v1
LITELLM_API_KEY=
LOCAL_MODEL=llama-3.3-70b-lmstudio

# ── PDDL solver ───────────────────────────────────────────────────────────────
# remote = course path: @unitn-asa/pddl-client onlineSolver, zero-setup (but ~3s, satisficing).
# local  = optional enhancement: a planner binary via child_process — no Docker — optimal & ~90ms.
#          We keep it to DEMONSTRATE PDDL beating greedy. Install: pip install pyperplan.
PDDL_SOLVER=remote
PDDL_SOLVER_URL=https://solver.planning.domains:5001/package/dual-bfws-ffparser/solve
# PDDL_SOLVER=local
# PDDL_LOCAL_CMD=./.venv-pddl/bin/pyperplan -s astar -H lmcut

# ── Behaviour switches ────────────────────────────────────────────────────────
PLANNER=reactive        # reactive | pddl
LOG_LEVEL=info          # debug | info | warn | error

# ── Optional: course tool-catalog server (only if/when provided) ──────────────
# TOOLS_API_URL=
