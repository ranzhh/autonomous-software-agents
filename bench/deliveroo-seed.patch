@@ -0,0 +1,40 @@
+import { createHash } from 'node:crypto';
+
+/**
+ * Seeded random streams for the game's own draws (parcel rewards, spawn tiles,
+ * agent placement, NPC moves). Each consumer gets its own stream so the order in
+ * which consumers interleave does not shift the others' sequences.
+ *
+ * Unset SEED keeps Math.random everywhere: upstream behaviour is unchanged.
+ */
+
+const SEED = process.env.SEED;
+
+/**
+ * mulberry32: a small 32-bit generator with uniform output in [0, 1).
+ * @param {number} state
+ * @returns {() => number}
+ */
+function mulberry32(state) {
+    let a = state >>> 0;
+    return () => {
+        a = (a + 0x6D2B79F5) | 0;
+        let t = Math.imul(a ^ (a >>> 15), 1 | a);
+        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+}
+
+/**
+ * A random stream named after its consumer, derived from SEED.
+ * @param {string} name
+ * @returns {() => number}
+ */
+export function randomStream(name) {
+    if (SEED === undefined || SEED === '')
+        return Math.random;
+    const digest = createHash('sha256').update(`${SEED}:${name}`).digest();
+    return mulberry32(digest.readUInt32LE(0));
+}
+
+export const seeded = SEED !== undefined && SEED !== '';
